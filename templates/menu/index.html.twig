{% extends 'layout.html.twig' %}

{% block title %}Menu{% endblock %}

{% block content %}
<div>
    <h1>Notre menu</h1>

    <img style="height:400px;" src="https://www.ardamez.com/wp-content/uploads/2023/11/04-lauren-kimminn-photographe-ardamez-tables-bistrot-bistrot-yonnais-monkey-bar-hotel-mercure-la-roche-sur-yon-18072023-scaled.jpg" alt="Random Image">

    <p>La date d'aujourd'hui est : {{ date|format_date(pattern='d MMMM Y', locale='fr') }}</p>
    
    <p>Voici le menu :</p>


    <div>
    {% for item in menu_items %}
        <div>
            <img src="{{ item.img }}" style="height: 200px;">
            <div>
                {{ item.name }} - {{ item.description }} ({{ item.price }}€)
            </div>
        </div>
    {% else %}
        <div>Rupture de stock, revenez plus tard.</div>
    {% endfor %}
    </div>

    <a href="{{ path('app_index') }}">Retour à la page d'accueil</a>

</div>



{% endblock %}
